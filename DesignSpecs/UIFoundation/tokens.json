{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "MetaUI Design Tokens(DTCG 2025.10）。SSOT——tokens.css / 00_TokenSheet.md / Design.md 數據段皆由此生成,禁手改。",
  "$modes": ["light", "dark"],
  "$extensions": {
    "metaui": {
      "version": "0.3.1",
      "provenance": "DS@0.1.0(基線)+試點回收(warning 語意+展示層槽,值=試點起始值可覆蓋;專案主題值不回收)+結構回收(on-* 前景色體系+tertiary 槽,eco-pay 回件案源)",
      "source": "storybook-snapshot 回推 + 02_農業氣象試點回收 + eco-pay 結構回收(規則=40_TokenPipeline 回收節)",
      "usage-rule": "元件/頁面只准引 semantic tier token;primitive tier 只准被 alias 引用（F-2 裁決）"
    }
  },

  "color": {
    "$type": "color",

    "primary": {
      "$value": "#176466",
      "$description": "品牌主色",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "primary-emphasis": {
      "$value": "#0a3738",
      "$description": "主色強調(原 primary-darken,F-5 改名)",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "primary-soft": {
      "$value": "#d9efef",
      "$description": "主色柔和(原 primary-lighten,F-5 改名)",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "primary-container": {
      "$value": "#eef4f3",
      "$description": "主色容器背景",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "secondary": {
      "$value": "#fc890c",
      "$description": "品牌輔色",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "secondary-emphasis": {
      "$value": "#6b4823",
      "$description": "輔色強調(原 secondary-darken,F-5 改名;dark mode 值由 mode 表切換)",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "secondary-soft": {
      "$value": "#ffecd8",
      "$description": "輔色柔和(原 secondary-lighten,F-5 改名;dark mode 值由 mode 表切換)",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "secondary-container": {
      "$value": "#fff8eb",
      "$description": "輔色容器背景",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },

    "tertiary": {
      "$value": "#554677",
      "$description": "品牌第三色槽(結構回收:eco-pay 回件案源;試點回收起始值,專案可覆蓋;白字對比 8.3 過 AAA;圖表序列色屬另一語意,不與品牌角色共用鍵)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "tertiary-emphasis": {
      "$value": "#2e2545",
      "$description": "第三色強調(同構 primary/secondary 家族 -emphasis;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "tertiary-soft": {
      "$value": "#e6e1f0",
      "$description": "第三色柔和(對 text 對比 11.3;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "tertiary-container": {
      "$value": "#f1eef7",
      "$description": "第三色容器背景(對 text 對比 12.7;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },

    "on-primary": {
      "$value": "#ffffff",
      "$description": "primary 底上前景(對比 6.9 過 AA;與 Vuetify theme on-* 慣例同名=消費端對接點;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-secondary": {
      "$value": "#212b2b",
      "$description": "secondary 底上前景(亮底深字慣例,對比 6.0 過 AA;secondary 無 dark 覆寫,本鍵不隨 mode 翻轉;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-tertiary": {
      "$value": "#ffffff",
      "$description": "tertiary 底上前景(對比 8.3;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-primary-container": {
      "$value": "#212b2b",
      "$description": "primary-container 底上前景(深字,對比 13.1;on-* 補遺=容器淺底配深字,與 on-primary 白字不可代用;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-secondary-container": {
      "$value": "#212b2b",
      "$description": "secondary-container 底上前景(深字,對比 13.8;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-tertiary-container": {
      "$value": "#212b2b",
      "$description": "tertiary-container 底上前景(深字,對比 12.7;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },

    "text": {
      "$value": "#212b2b",
      "$description": "文字基色(F-1 裁決:title #373b3c 與 font #212b2b 合併,取較深值)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "F-1" } }
    },
    "subtitle": {
      "$value": "#4c5858",
      "$description": "副標題文字色",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "placeholder": {
      "$value": "#757575",
      "$description": "佔位文字色",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },

    "background": {
      "$value": "#ffffff",
      "$description": "頁面底色(F-3 裁決:原 white 拆分,頁面底→background)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "F-3", "vuetify-key": "background" } }
    },
    "surface": {
      "$value": "#fbfdfb",
      "$description": "卡片/元件面色",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "F-3", "vuetify-key": "surface" } }
    },
    "surface-variant": {
      "$value": "#f3f7fa",
      "$description": "次要面色(F-4 裁決:原 container 改名,避免與 M3 -container 後綴衝突)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "F-4", "vuetify-key": "surface-variant" } }
    },

    "primary-bright": {
      "$value": "#39959b",
      "$description": "亮調主色(展示層:飾線/圖形/hover 大字用,非內文文字色——AA 依用途驗算;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },
    "hero-bg": {
      "$value": "#12403f",
      "$description": "展示層 hero 深色帶底(45_PrototypeView 展示層槽;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },
    "hero-bg-deep": {
      "$value": "#0a2b2a",
      "$description": "展示層 hero 漸層深端/頁尾底(試點回收)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },
    "hero-text": {
      "$value": "#f2f9f8",
      "$description": "展示層 hero 上主文字(對 hero-bg 對比 10.7 過 AAA;試點回收)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },
    "hero-muted": {
      "$value": "#9cc5c1",
      "$description": "展示層 hero 上次要文字(對 hero-bg 對比 6.1 過 AA;試點回收)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },
    "band-soft": {
      "$value": "#eef6f5",
      "$description": "展示層淺色段帶底(淺深節奏用;對 text 對比 >13;試點回收)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },

    "divider": {
      "$value": "#bfc8c6",
      "$description": "分隔線色",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "stroke": {
      "$value": "#8e9190",
      "$description": "邊框/描邊色",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "disabled": {
      "$value": "#d8d8d8",
      "$description": "停用狀態色",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },

    "red1": {
      "$value": "#cd3033",
      "$description": "紅色 primitive(F-2:只供 alias 引用,元件不直接使用)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "F-2" } }
    },
    "red1-container": {
      "$value": "#fff9f9",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "green1": {
      "$value": "#138251",
      "$description": "綠色 primitive",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "F-2" } }
    },
    "green1-container": {
      "$value": "#f8fffc",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "blue1": {
      "$value": "#0168ee",
      "$description": "藍色 primitive",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "F-2" } }
    },
    "blue1-container": {
      "$value": "#f3f8ff",
      "$extensions": { "metaui": { "tier": "primitive" } }
    },
    "orange1": {
      "$value": "#b45309",
      "$description": "橘色 primitive(警戒語意保留區;試點回收起始值——對齊 CWA 警戒色階慣例,CTA 不得用橘)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },
    "orange1-container": {
      "$value": "#fff4e5",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "audit-A1" } }
    },

    "text-heading": {
      "$value": "{color.text}",
      "$description": "標題文字色(F-1 semantic alias)",
      "$extensions": { "metaui": { "tier": "semantic", "resolved": "F-1" } }
    },
    "text-body": {
      "$value": "{color.text}",
      "$description": "內文文字色(F-1 semantic alias)",
      "$extensions": { "metaui": { "tier": "semantic", "resolved": "F-1" } }
    },
    "error": {
      "$value": "{color.red1}",
      "$description": "錯誤語意色(F-2 semantic alias → red1)",
      "$extensions": { "metaui": { "tier": "semantic", "resolved": "F-2" } }
    },
    "error-container": {
      "$value": "{color.red1-container}",
      "$extensions": { "metaui": { "tier": "semantic" } }
    },
    "success": {
      "$value": "{color.green1}",
      "$description": "成功語意色(F-2 semantic alias → green1)",
      "$extensions": { "metaui": { "tier": "semantic", "resolved": "F-2" } }
    },
    "success-container": {
      "$value": "{color.green1-container}",
      "$extensions": { "metaui": { "tier": "semantic" } }
    },
    "info": {
      "$value": "{color.blue1}",
      "$description": "資訊語意色(F-2 semantic alias → blue1)",
      "$extensions": { "metaui": { "tier": "semantic", "resolved": "F-2" } }
    },
    "info-container": {
      "$value": "{color.blue1-container}",
      "$extensions": { "metaui": { "tier": "semantic" } }
    },
    "warning": {
      "$value": "{color.orange1}",
      "$description": "警示語意色(semantic alias → orange1;補齊 error/success/info/warning 四語意;試點回收)",
      "$extensions": { "metaui": { "tier": "semantic", "resolved": "audit-A1" } }
    },
    "warning-container": {
      "$value": "{color.orange1-container}",
      "$extensions": { "metaui": { "tier": "semantic", "resolved": "audit-A1" } }
    },

    "on-error": {
      "$value": "#ffffff",
      "$description": "error 底上前景(light 對 red1 對比 5.2 過 AA;dark 隨 red1 提亮翻轉深字;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-success": {
      "$value": "#ffffff",
      "$description": "success 底上前景(light 對 green1 對比 4.8 過 AA;dark 隨 green1 提亮翻轉深字;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-info": {
      "$value": "#ffffff",
      "$description": "info 底上前景(對 blue1 對比 5.0 過 AA;blue1 無 dark 覆寫,本鍵不翻轉;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-warning": {
      "$value": "#ffffff",
      "$description": "warning 底上前景(light 對 orange1 對比 5.0 過 AA;dark 隨 orange1 提亮翻轉深字;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-error-container": {
      "$value": "#212b2b",
      "$description": "error-container 底上前景(深字,對比 14.0;on-* 補遺;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-success-container": {
      "$value": "#212b2b",
      "$description": "success-container 底上前景(深字,對比 14.3;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-info-container": {
      "$value": "#212b2b",
      "$description": "info-container 底上前景(深字,對比 13.6;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    },
    "on-warning-container": {
      "$value": "#212b2b",
      "$description": "warning-container 底上前景(深字,對比 13.4;試點回收起始值,專案可覆蓋)",
      "$extensions": { "metaui": { "tier": "primitive", "resolved": "ecopay-1" } }
    }
  },

  "color-dark": {
    "$type": "color",
    "$description": "Dark mode 覆寫(僅列與 light mode 不同的值;CSS 生成時寫入 [data-theme=dark_mode] 選擇器)",
    "primary": { "$value": "#57cbcf" },
    "primary-container": { "$value": "#131315" },
    "secondary-emphasis": {
      "$value": "#ffecd8",
      "$description": "F-5:dark mode 下強調色為淺色(在深底上凸顯)"
    },
    "secondary-soft": {
      "$value": "#6b4823",
      "$description": "F-5:dark mode 下柔和色為深色(在深底上融合)"
    },
    "text": { "$value": "#ffffff" },
    "subtitle": { "$value": "#ffffff" },
    "background": { "$value": "#2f2e31" },
    "surface": { "$value": "#2f2e31" },
    "surface-variant": { "$value": "#1a1a1a" },
    "disabled": { "$value": "#3f3f3f" },
    "red1": { "$value": "#f96063" },
    "green1": { "$value": "#54c594" },
    "orange1": { "$value": "#ffaf54", "$description": "試點回收(dark 提亮)" },
    "band-soft": { "$value": "#16302f", "$description": "試點回收(dark 段帶轉深,層次對比保留)" },
    "on-primary": { "$value": "#0a3738", "$description": "結構回收:dark primary 轉亮(#57cbcf)→前景翻深墨青(對比 6.7 過 AA;eco-pay 回件指出之實害修法)" },
    "on-primary-container": { "$value": "#ffffff", "$description": "on-* 補遺:dark primary-container 轉深(#131315)→前景翻白(對比 18.6);其餘 *-container 無 dark 覆寫,on- 深字沿用合法" },
    "on-error": { "$value": "#212b2b", "$description": "結構回收:dark red1 提亮→前景翻深(對比 4.8)" },
    "on-success": { "$value": "#212b2b", "$description": "結構回收:dark green1 提亮→前景翻深(對比 6.8)" },
    "on-warning": { "$value": "#212b2b", "$description": "結構回收:dark orange1 提亮→前景翻深(對比 8.0)" }
  },

  "typography": {
    "$description": "字型系統。全域 line-height 1.5。letter-spacing 未 token 化——採納候回收通道,值待設計確認。",
    "font-family": {
      "sans": {
        "$value": "roboto, Noto Sans TC, sans-serif",
        "$type": "fontFamily"
      }
    },
    "font-size": {
      "$type": "dimension",
      "display1": { "$value": "2.75rem", "$description": "44px(展示層 hero 主標;試點回收)" },
      "display2": { "$value": "2rem", "$description": "32px(展示層段帶標題;試點回收)" },
      "head1": { "$value": "1.75rem", "$description": "28px" },
      "head2": { "$value": "1.5rem", "$description": "24px" },
      "subtitle1": { "$value": "1.25rem", "$description": "20px" },
      "subtitle2": { "$value": "1.125rem", "$description": "18px" },
      "body1": { "$value": "1rem", "$description": "16px(基準)" },
      "body2": { "$value": "0.875rem", "$description": "14px" }
    },
    "font-weight": {
      "$type": "number",
      "bold": { "$value": 700 },
      "medium": { "$value": 500 },
      "regular": { "$value": 400 }
    },
    "line-height": {
      "$type": "number",
      "default": { "$value": 1.5 },
      "display": { "$value": 1.25, "$description": "展示層 display 字階專用(試點回收)" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "間距 scale(4pt grid 對齊)",
    "1": { "$value": "2px" },
    "2": { "$value": "4px" },
    "3": { "$value": "8px" },
    "4": { "$value": "12px" },
    "5": { "$value": "16px" },
    "6": { "$value": "20px" },
    "7": { "$value": "24px" },
    "8": { "$value": "32px" },
    "9": { "$value": "48px", "$description": "展示層 band 垂直呼吸(試點回收)" },
    "10": { "$value": "64px", "$description": "展示層 hero 垂直呼吸(試點回收)" },
    "11": { "$value": "96px", "$description": "展示層大段落間距(試點回收)" }
  },

  "radius": {
    "$type": "dimension",
    "s": { "$value": "4px" },
    "m": { "$value": "8px" },
    "l": { "$value": "20px" },
    "xl": { "$value": "999px", "$description": "pill" }
  },

  "shadow": {
    "$type": "shadow",
    "card": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-2px", "color": "rgba(0,0,0,0.1)" } },
    "popover": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px", "color": "rgba(0,0,0,0.2)" } },
    "dialog": { "$value": { "offsetX": "0px", "offsetY": "11px", "blur": "15px", "spread": "0px", "color": "rgba(0,0,0,0.2)" } }
  },

  "z-index": {
    "$type": "number",
    "map": { "$value": 1 },
    "panel": { "$value": 2 },
    "popover": { "$value": 20 },
    "tooltip": { "$value": 100 },
    "header": { "$value": 1005 },
    "to-top": { "$value": 1005 },
    "left-menu": { "$value": 1006 },
    "dialog": { "$value": 1010 },
    "alert": { "$value": 3000 },
    "backdrop": { "$value": 9998 },
    "fetch-loading": { "$value": 9999 }
  },

  "breakpoint": {
    "$type": "dimension",
    "xs-mobile": { "$value": "375px", "$description": "max-width" },
    "tablet": { "$value": "768px" },
    "laptop": { "$value": "1280px" },
    "desktop": { "$value": "1440px" },
    "xl-desktop": { "$value": "1920px" }
  },

  "layout": {
    "$type": "dimension",
    "header-height": { "$value": "60px" },
    "backstage-header-height": { "$value": "56px" },
    "content-width": { "$value": "1120px", "$description": "展示層 prototype 內容欄寬(試點回收)" }
  },

  "transition": {
    "$type": "transition",
    "fast": { "$value": "all 0.2s ease-in-out" },
    "slow": { "$value": "all 0.5s ease-in-out" }
  },

  "focus": {
    "visible": {
      "$value": "4px dashed var(--color-secondary)",
      "$type": "border"
    }
  }
}
